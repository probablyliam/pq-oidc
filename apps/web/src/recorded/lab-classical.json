    },
    {
      "id": "auth.exposure",
      "layer": "server-authentication",
      "kind": "inference",
      "tone": "caution",
      "title": "A quantum computer could impersonate this server, but only at the time of an attack",
      "detail": "The server’s identity rests on the certificate key (ECDSA P-256) and a chain signature (ECDSA with SHA-256). Shor’s algorithm recovers such private keys from the public keys, which would let an attacker present this identity. Unlike key exchange, this cannot be used on recorded traffic: the forgery has to be made, with a working quantum computer, during a live connection while the certificate is still valid. Publicly trusted certificate authorities do not issue post-quantum certificates yet, so a public site cannot change this alone today.",
      "basedOn": [
        "auth.certificate",
        "auth.proof"
      ],
      "learn": {
        "view": "login",
        "landmark": "forgery",
        "mode": "classical",
        "attacker": "quantum",
        "label": "Watch a signature being forged"
      }
    },

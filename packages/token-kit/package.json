  "private": true,
  "description": "Shared helpers to read, measure and verify JWTs signed with classical or post-quantum algorithms. Runs in Node and in browsers.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./algorithms": "./src/algorithms.ts",
    "./base64url": "./src/base64url.ts",
    "./measure": "./src/measure.ts",
    "./html": "./src/html.ts",
    "./limits": "./src/limits.ts",
    "./projection": "./src/projection.ts",
    "./readiness": "./src/readiness.ts",
    "./analyze": "./src/analyze.ts",
    "./signature": "./src/signature.ts",
    "./jose": "./src/jose.ts"
  },
  "dependencies": {
    "jose": "6.2.12",
    "@noble/post-quantum": "0.7.1"
  }
}

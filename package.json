{
  "name": "pq-oidc",
  "version": "0.1.0",
  "private": true,
  "description": "A scanner that reports the cryptographic posture of a sign-in endpoint against quantum attackers, an interactive explanation of what it finds, and an OpenID Connect provider that signs with ML-DSA-65.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning scripts/start-all.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w apps/web",
    "lint": "eslint .",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke.ts",
    "check": "node --disable-warning=ExperimentalWarning scripts/check.ts",
    "interop": "node --disable-warning=ExperimentalWarning scripts/interop.ts",
    "prove": "node --disable-warning=ExperimentalWarning scripts/prove.ts",
    "scan": "node --disable-warning=ExperimentalWarning scripts/scan.ts",
    "web:dev": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "lab": "node --disable-warning=ExperimentalWarning scripts/lab.ts",
    "dev": "node --disable-warning=ExperimentalWarning scripts/start-all.ts --dev",
    "oidc": "node --disable-warning=ExperimentalWarning scripts/start-oidc.ts",
    "vercel:bundle": "rolldown services/vercel/src/scan.ts --platform node --format esm --file api/v1/scan.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "playwright-core": "1.63.0",
    "rolldown": "1.2.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/probablyliam/pq-oidc.git"
  },
  "keywords": [
    "oidc",
    "oauth2",
    "post-quantum",
    "ml-dsa",
    "rfc9964",
    "fips204",
    "jwt"
  ]
}

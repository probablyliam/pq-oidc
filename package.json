{
  "name": "pq-oidc",
  "version": "0.1.0",
  "private": true,
  "description": "A crypto-agile OpenID Connect provider that migrates ID token signing from ES256 to post-quantum ML-DSA-65 (RFC 9964), one client at a time.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning scripts/start-all.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w apps/lab",
    "lint": "eslint .",
    "lab:dev": "npm run dev -w apps/lab",
    "lab:build": "npm run build -w apps/lab",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke.ts",
    "check": "node --disable-warning=ExperimentalWarning scripts/check.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/probablyliam/pq-oidc.git"
  },
  "keywords": [
    "oidc",
    "oauth2",
    "post-quantum",
    "ml-dsa",
    "rfc9964",
    "fips204",
    "jwt"
  ]
}

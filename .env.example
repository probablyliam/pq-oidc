# Provider (packages/provider/src/server.ts)
PORT=3000
ISSUER=http://localhost:3000
LEGACY_REDIRECT_URI=http://localhost:3001/callback
PQ_REDIRECT_URI=http://localhost:3002/callback
# Which algorithm each app's ID tokens are signed with: ES256 or ML-DSA-65
LEGACY_ID_TOKEN_ALG=ES256
PQ_ID_TOKEN_ALG=ML-DSA-65
LEGACY_CLIENT_SECRET=legacy-app-demo-secret
PQ_CLIENT_SECRET=pq-app-demo-secret
# Optional: private JWKS with one ES256 and one ML-DSA-65 key (generated in memory if unset)
SIGNING_KEYS_JSON=
# Optional: comma-separated keys for signing the provider's cookies (random if unset)
COOKIE_KEYS=
# Set to true behind a TLS-terminating proxy or ingress
TRUST_PROXY=false

# Demo apps (packages/rp/src/server.ts)
RP_PRESET=legacy
BASE_URL=http://localhost:3001
CLIENT_SECRET=legacy-app-demo-secret
# Where the app can reach the provider server-to-server, if not at ISSUER
INTERNAL_ISSUER=
OTHER_APP_URL=http://localhost:3002/

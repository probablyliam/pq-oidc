# ---- Scanner API (services/api/src/server.ts) ----
PORT=8080
# The worker's job queue and /metrics. Keep it off the public network.
INTERNAL_PORT=8081
HOST=127.0.0.1
# What visitors see in their address bar: cross-site requests are refused by comparing against it.
PUBLIC_URL=http://localhost:8080
# Shared secret the worker presents, at least 32 characters. The demo value is refused when NODE_ENV=production.
WORKER_TOKEN=
DATABASE_PATH=data/scans.sqlite
# Set to true behind a TLS-terminating proxy or ingress, so the client address comes from X-Forwarded-For.
TRUST_PROXY=false
# Serve the built web app from here (npm run web:build writes apps/web/dist).
WEB_DIR=apps/web/dist
# Ports a scan may connect to.
SCAN_ALLOWED_PORTS=443,8443
# Local test servers exempt from the address rules. Development only; `npm start` sets it.
SCAN_LAB_ORIGINS=
# Limits, per visitor and per scanned service.
RATE_LIMIT_SCANS=20
RATE_LIMIT_WINDOW_SECONDS=600
MAX_ACTIVE_SCANS_PER_CLIENT=3
RATE_LIMIT_PER_HOST=3
MAX_QUEUE_DEPTH=100
# A repeat of the same address within this window is answered with the earlier result.
REUSE_RESULT_SECONDS=300
# Results are deleted after this.
RETENTION_HOURS=1
LOG_LEVEL=info

# ---- Scanner worker (services/worker/src/server.ts) ----
API_INTERNAL_URL=http://127.0.0.1:8081
WORKER_CONCURRENCY=2

# ---- OIDC provider (packages/provider/src/server.ts), started by `npm run oidc` ----
ISSUER=http://localhost:3000
LEGACY_REDIRECT_URI=http://localhost:3001/callback
PQ_REDIRECT_URI=http://localhost:3002/callback
# Which algorithm each app's ID tokens are signed with: ES256 or ML-DSA-65
LEGACY_ID_TOKEN_ALG=ES256
PQ_ID_TOKEN_ALG=ML-DSA-65
LEGACY_CLIENT_SECRET=legacy-app-demo-secret
PQ_CLIENT_SECRET=pq-app-demo-secret
# Optional: private JWKS with one ES256 and one ML-DSA-65 key (generated in memory if unset)
SIGNING_KEYS_JSON=
# Optional: comma-separated keys for signing the provider's cookies (random if unset)
COOKIE_KEYS=

# ---- Demo apps (packages/rp/src/server.ts) ----
RP_PRESET=legacy
BASE_URL=http://localhost:3001
CLIENT_SECRET=legacy-app-demo-secret
# Where the app can reach the provider server-to-server, if not at ISSUER
INTERNAL_ISSUER=
OTHER_APP_URL=http://localhost:3002/
